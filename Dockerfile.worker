# ---- build stage ----------------------------------------------------------
FROM node:26-alpine AS build
RUN apk upgrade --no-cache && apk add --no-cache --upgrade 'zlib>=1.4'
WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

# ---- worker stage (heavy document-rendering tier) -------------------------
# This is the second tier of Folio's processing architecture. It runs the same
# job server as the application image, but with the engines that need several
# hundred MB of RAM and a full office suite:
#
#   libreoffice-* -> Word/Excel/PowerPoint -> PDF, HTML/Markdown/URL -> PDF
#   imagemagick   -> only needed if a handler is ever written that shells out
#                    to it; kept here so the worker can host such handlers
#
# Deploy this image on a host with at least 2 GB RAM and point the application
# at it (see DEPLOYMENT.md, "Two-tier processing"). It is NOT the image used by
# the AppJet application deployment: the application host runs Dockerfile, and
# the 1 GB entitlement cannot hold LibreOffice alongside the web server.
#
# Advisory note: glib (pulled in by LibreOffice) and imagemagick carry scanner
# findings whose listed "fixed versions" are older than the builds Alpine
# v3.24 ships, so they cannot be resolved by upgrading. That is why the heavy
# engines are isolated in this tier instead of blocking the whole application.
FROM node:26-alpine AS runtime
RUN apk upgrade --no-cache \
 && apk add --no-cache --upgrade 'zlib>=1.4' \
      qpdf \
      poppler-utils \
      tesseract-ocr \
      tesseract-ocr-data-eng \
      libreoffice-writer \
      libreoffice-calc \
      libreoffice-impress \
      fontconfig \
      ttf-liberation \
      ttf-dejavu \
      imagemagick

WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

COPY --from=build /app/dist ./dist
COPY server ./server
COPY server.mjs ./server.mjs

# LibreOffice and Tesseract write profiles/temp data into $HOME.
ENV HOME=/home/node
ENV PORT=3000
ENV FOLIO_ROOT=/app/dist
ENV FOLIO_JOB_DIR=/tmp/folio-jobs
# Heavy Office rendering is serialised even on a larger worker.
ENV FOLIO_HEAVY_CONCURRENCY=1
ENV FOLIO_LIGHT_CONCURRENCY=2
ENV FOLIO_JOB_TIMEOUT_MS=180000
ENV FOLIO_ENGINE_TIMEOUT_MS=120000

EXPOSE 3000
USER node
CMD ["node", "server.mjs"]
