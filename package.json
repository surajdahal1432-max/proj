{
  "name": "folio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Folio \u2014 local-first PDF productivity and document intelligence platform",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:pipelines": "npx -y node@22.23.4 --import tsx --test tests/pipelines.test.ts",
    "test:all": "npx -y node@22.23.4 --test tests/*.test.mjs && npx -y node@22.23.4 --import tsx --test tests/pipelines.test.ts tests/regression.test.ts tests/organize.test.ts",
    "test:regression": "tsx --test tests/regression.test.ts",
    "test:organize": "npx -y node@22.23.4 --import tsx --test tests/organize.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^6.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "overrides": {
    "image-size": "^2.0.3"
  }
}
